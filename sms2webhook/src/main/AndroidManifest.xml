<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Make the telephony hardware feature not mandatory -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Request necessary permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Setup QR scanning. The camera is optional so the app still installs on a
         device without one; scanning is simply unavailable there. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- allowBackup and fullBackupContent cover API 28-30; dataExtractionRules
         covers API 31+, where transfer is governed by the rules rather than by
         allowBackup. All three are off because the webhook URL and its API key sit
         in the default preference store in cleartext: a backup would export the
         credential off the device. See res/xml/data_extraction_rules.xml. -->
    <application
        android:name="org.golder.sms2webhook.MainApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SMS2Webhook"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Main activity with single top launch mode and exported -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings activity with parent activity defined -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/action_settings"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <!-- Broadcast receiver for receiving SMS data -->
        <receiver
            android:name=".SmsBroadcastReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>